<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="15dp">

        <!-- Collapsed View (always visible) -->
        <LinearLayout
            android:id="@+id/collapsed_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header: Date and Total -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_date"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Dec 4, 2023 2:30 PM"
                    android:textSize="12sp"
                    android:textColor="@android:color/darker_gray" />

                <TextView
                    android:id="@+id/tv_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₱1500"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary" />

            </LinearLayout>

            <!-- Medicine Count -->
            <TextView
                android:id="@+id/tv_medicine_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3 medicine(s)"
                android:textSize="11sp"
                android:textColor="@android:color/darker_gray"
                android:layout_marginTop="2dp" />

            <!-- Time Limit Indicator -->
            <TextView
                android:id="@+id/tv_time_limit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⏰ 30 min limit"
                android:textSize="11sp"
                android:textColor="@android:color/holo_blue_dark"
                android:visibility="gone"
                android:layout_marginTop="2dp" />

            <!-- Medicines List Preview -->
            <TextView
                android:id="@+id/tv_medicines"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Paracetamol (x2), Biogesic (x1)..."
                android:textSize="12sp"
                android:layout_marginTop="8dp"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:gravity="center">

                <Button
                    android:id="@+id/btn_toggle_details"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="Show Details"
                    android:textSize="12sp"
                    android:backgroundTint="@color/primary"
                    android:textColor="@android:color/white" />

                <Button
                    android:id="@+id/btn_received"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="Mark as Received"
                    android:textSize="12sp"
                    android:backgroundTint="@color/confirm_green"
                    android:textColor="@android:color/white" />

            </LinearLayout>
        </LinearLayout>

        <!-- Expanded View (hidden by default) -->
        <LinearLayout
            android:id="@+id/expanded_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="16dp"
            android:paddingTop="16dp"
            android:background="@drawable/expanded_background">

            <!-- Expand/Collapse Indicator -->
            <ImageView
                android:id="@+id/iv_expand_indicator"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:src="@drawable/ic_expand_less"
                android:contentDescription="Collapse"
                android:gravity="center"
                android:layout_marginBottom="8dp"/>

            <!-- Detailed Medicines List -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Medicines Details:"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tv_medicines_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="16dp"/>

            <!-- Prescription Warning -->
            <TextView
                android:id="@+id/tv_prescription_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚠️ Contains prescription medicines"
                android:textSize="12sp"
                android:textColor="@android:color/holo_orange_dark"
                android:visibility="gone"
                android:layout_marginBottom="16dp"/>

            <!-- Customer Info (if available) -->
            <TextView
                android:id="@+id/tv_customer_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="👤 Customer: John Doe\n📞 Phone: 0912-345-6789"
                android:textSize="12sp"
                android:visibility="gone"
                android:layout_marginBottom="8dp"/>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>